# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored (see .gitignore at repo root) — never commit
# the copy. This .example file is the only tfvars-shaped file that should
# ever be in git.

snowflake_organization_name = "myorg"
snowflake_account_name      = "myaccount"
snowflake_user              = "TF_DEPLOYER"
snowflake_role              = "ACCOUNTADMIN"
snowflake_private_key_path  = "/path/to/tf_deployer_key.p8"
# snowflake_private_key_passphrase = ""   # only if the key is encrypted

warehouse_name = "O2C_WH"
warehouse_size = "XSMALL"
database_name  = "O2C_DB"

runtime_role_name = "O2C_APP"
runtime_users      = ["O2C_APP_SVC_USER"]

# ── Gmail OAuth — see terraform/README.md item 1 for how to produce these
# three values (one-time browser consent, cannot be scripted) ──────────────
gmail_client_id     = "xxxxx.apps.googleusercontent.com"
gmail_client_secret = "GOCSPX-xxxxx"
gmail_refresh_token  = "1//xxxxx"

# ── Azure Document Intelligence ─────────────────────────────────────────────
azure_di_endpoint_host = "yourresource.cognitiveservices.azure.com"
azure_di_api_key       = "xxxxx"

# ── Optional, off by default — see 07_network_and_secrets.tf comment ──────
# create_unused_llm_integration = false
# groq_api_key                  = ""
